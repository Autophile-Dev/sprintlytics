# MongoDB Connection
# Set your MongoDB connection URI (e.g. mongodb+srv://username:password@cluster.mongodb.net/dbname)
MONGODB_URI=mongodb://localhost:27017/sprintlytics

# JWT Configuration
# Choose a strong secret for JWT signing (e.g., generate using 'openssl base64 -out secret.txt' or similar)
JWT_SECRET=your_jwt_secret_key_change_me_in_production
JWT_EXPIRES_IN=1h

# Gmail SMTP Configuration for OTP Emails
# Ensure 2-Step Verification is enabled on your Gmail account, then generate an App Password.
# Note: Do not use your primary Gmail password; use a 16-character Google App Password.
SMTP_USER=your_gmail_address@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM="Sprintlytics Auth <your_gmail_address@gmail.com>"

# Security & Environment Options
NODE_ENV=development
SECURE_COOKIES=false
# Hostname/URL of front-end for CORS/redirect permissions if applicable
FRONTEND_URL=http://localhost:3000
